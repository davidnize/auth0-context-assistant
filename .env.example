# Session encryption secret (at least 32 characters).
# Generate one with: openssl rand -hex 32
AUTH0_SECRET=replace-with-a-long-random-string-at-least-32-chars

# The URL where this app runs.
AUTH0_BASE_URL=http://localhost:3000

# From Auth0 Dashboard > Applications > Your App > Settings
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret

# Your Auth0 tenant domain, including https://
# Example: https://dev-abc123.us.auth0.com
AUTH0_ISSUER_BASE_URL=https://YOUR_AUTH0_DOMAIN

# API Identifier from Auth0 Dashboard > Applications > APIs
# Example: https://context-assistant-api
AUTH0_AUDIENCE=https://context-assistant-api

# Optional. Most hosts set this automatically.
# PORT=3000
